{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GlyphShift: Convert to WOFF2",
      "type": "shell",
      "command": "glyphshift convert \"${file}\" --profile web --json",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "GlyphShift: Font info",
      "type": "shell",
      "command": "glyphshift info \"${file}\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "GlyphShift: Coverage check",
      "type": "shell",
      "command": "glyphshift coverage \"${file}\"",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "GlyphShift: CSS @font-face bundle",
      "type": "shell",
      "command": "glyphshift css \"${file}\" --bundle",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
